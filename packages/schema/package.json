{
  "name": "@keepcv/schema",
  "version": "0.0.0",
  "description": "Zod definitions, DTOs and schema versioning for KeepCV. The single source of truth for every shared shape.",
  "keywords": [
    "keepcv",
    "zod",
    "schema",
    "resume",
    "cv"
  ],
  "license": "MIT",
  "author": "nrautela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keepcv/keepcv.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/keepcv/keepcv/issues"
  },
  "homepage": "https://github.com/keepcv/keepcv/tree/main/packages/schema#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
