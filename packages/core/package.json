{
  "name": "@keepcv/core",
  "version": "0.0.0",
  "description": "KeepCV domain logic. Pure: no I/O, no database, no network. Runs unchanged in Node and the browser.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@keepcv/schema": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
