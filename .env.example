# Copy to .env beside compose.yaml. Paths refer to the container filesystem.
KEEPCV_DATA_DIR=/data
KEEPCV_HOST=0.0.0.0
KEEPCV_PORT=4319
KEEPCV_ORIGIN=http://localhost:4319
KEEPCV_AUTH=password

# Optional proxy authentication settings.
KEEPCV_PROXY_HEADER=
KEEPCV_PROXY_FROM=
KEEPCV_PROXY_USER=

# Optional advanced model routes; mount the file into the container first.
KEEPCV_AGENT_CONFIG=
OPENROUTER_API_KEY=
